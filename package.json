{
  "name": "exampleForNew",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint source",
    "lint:fix": "npx eslint source --fix",
    "lint-staged": "lint-staged --allow-empty",
    "build-ci": "pnpm tsc -p ./tsconfig.json",
    "build": "tsc -p ./tsconfig.json && tsc-alias",
    "build:staging": "tsc -p ./tsconfig.json && tsc-alias && pnpm copy:assets",
    "build:production": "tsc -p ./tsconfig.json && tsc-alias && pnpm copy:assets",
    "copy:assets": "copyfiles -u 1 \"assets/**/*\" build/assets",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register -P tsconfig.json source/main.ts",
    "watch": "tsc -p ./tsconfig.json -w --incremental",
    "prepare": "husky install || (exit 0)",
    "bump": "pnpm update --latest && pnpm build",
    "test:unit": "jest --detectOpenHandles --testPathPattern=tests/unit --config=jest.config.ts",
    "test:api": "jest --testPathPattern=tests/api --config=jest.config.ts",
    "test": "jest --config=source/tests/jest.config.ts",
    "test:custom": "ts-node source/tests/run-tests.ts",
    "ngrok": "ngrok http \"http://localhost:3000\" --host-header=\"localhost:3000\""
  },
  "dependencies": {
    "@langchain/core": "^0.3.29",
    "@langchain/ollama": "^0.2.4",
    "@langchain/openai": "^0.5.15",
    "@typescript-eslint/parser": "8.13.0",
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-list-endpoints": "^7.1.0",
    "express-prom-bundle": "^8.0.0",
    "express-session": "^1.18.1",
    "ioredis": "^5.8.1",
    "joi": "^17.7.0",
    "langchain": "^0.3.29",
    "memorystore": "^1.6.7",
    "mysql2": "^3.15.0",
    "ollama": "^0.6.0",
    "onnxruntime-node": "^1.23.0",
    "openai": "^5.1.0",
    "pino": "^9.5.0",
    "pino-loki": "^2.5.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.10.1",
    "@types/body-parser": "^1.19.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "22.9.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.6.3",
    "winston": "^3.15.0"
  },
  "private": true
}
