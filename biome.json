{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignore": ["build/", "node_modules/", "package.json", "package-lock.json", "pnpm-lock.yaml", "openapi/", "postman/", "dist/**", "coverage/**"],
		"include": ["source/**/*.ts"],
		"ignoreUnknown": true
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"complexity": {
				"noUselessTernary": "error"
			},
			"security": {
				"noGlobalEval": "error"
			},
			"style": {
				"noVar": "error",
				"useConst": "error",
				"useSingleVarDeclarator": "error"
			},
			"suspicious": {
				"noDoubleEquals": "error",
				"noFallthroughSwitchClause": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"ignore": [],
		"attributePosition": "auto",
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 180,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
